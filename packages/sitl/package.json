{
  "name": "@ardudeck/sitl",
  "version": "0.1.0",
  "description": "ArduPilot SITL launching shared by the ArduDeck app and ArduDeck OS: swarms, frame defaults, process helpers. Node only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
