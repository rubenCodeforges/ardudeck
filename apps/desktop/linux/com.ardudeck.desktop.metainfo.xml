<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.ardudeck.desktop</id>
  <name>ArduDeck</name>
  <summary>Ground control station for ArduPilot, PX4, Betaflight and iNav vehicles</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="com.codeforges">
    <name>Codeforges</name>
  </developer>
  <description>
    <p>
      ArduDeck is an open-source ground control station. One app covers the whole workflow:
      connect, configure, calibrate, plan, fly and analyze, from a single quad on USB to a fleet
      of vehicles on radio, IP or cellular links.
    </p>
    <ul>
      <li>Live telemetry with a map-first cockpit and dockable instruments</li>
      <li>Parameter editing with review before every write, backups and history</li>
      <li>Mission and survey planning with grid, crosshatch and circular patterns</li>
      <li>Firmware flashing, calibration and sensor setup</li>
      <li>Flight log explorer with plots, FFT and health checks</li>
      <li>Built-in SITL simulator and multi-vehicle fleet support</li>
    </ul>
  </description>
  <launchable type="desktop-id">ardudeck.desktop</launchable>
